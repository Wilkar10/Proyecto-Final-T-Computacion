{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proposal-event.v1.json",
  "title": "Payload de proposal.created / proposal.decided v1",
  "type": "object",
  "required": ["proposalId", "robot", "orders", "cost", "algorithm", "exact", "status"],
  "properties": {
    "proposalId": {"type": "string"},
    "robot": {"type": "string"},
    "orders": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
    "cost": {"type": "integer", "minimum": 0},
    "algorithm": {"type": "string"},
    "exact": {"type": "boolean"},
    "status": {"type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "REJECTED", "EXECUTED", "FAILED"]},
    "decidedBy": {"type": "string"}
  },
  "additionalProperties": false
}
