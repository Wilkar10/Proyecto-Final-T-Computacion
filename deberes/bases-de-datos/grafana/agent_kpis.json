      "id": 1,
      "type": "timeseries",
      "title": "Tasa de aceptación",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "lakehouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day::timestamptz AS time, acceptance_rate AS \"Tasa de aceptación\" FROM mart_agent.kpis WHERE $__timeFilter(day) ORDER BY 1"
        }
      ]
    },
