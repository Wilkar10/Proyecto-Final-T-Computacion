# Copia a .env (no se versiona). Todo es opcional.
LP_MODE=lab                 # lab | fixture
LP_EXECUTE=0                # 1 = permite que el actuador ejecute propuestas aprobadas contra el lab
LP_PLANNER=rule             # rule | llm
LP_SOLVER_PLUGIN=           # Teoría: np_lab.plugin:build
LP_DATA_PLUGIN=             # BD:     lp_db.plugin:build
LP_AUDIT_PLUGIN=            # BD:     lp_db.plugin:build_sink
LP_ACTUATOR_PLUGIN=         # DSM:    lp_dsm.actuator:build
# Solo si LP_PLANNER=llm (NUNCA subas claves al repositorio):
ANTHROPIC_API_KEY=
LP_LLM_MODEL=

# --- Capa de API (gateway, claves, límite de tasa). Los valores por defecto son de DESARROLLO: cámbialos fuera del aula ---
# LAB_API_KEYS=dispatcher:cambia-esta-clave-larga:read,write;viewer:otra-clave-larga-distinta:read
# LAB_API_KEY=cambia-esta-clave-larga      # la que usa el agente (debe tener permiso write)
# LAB_RATE_BURST=20
# LAB_RATE_REFILL=10
